{
  "name": "twenty-app",
  "version": "0.1.9",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": "^24.5.0",
    "npm": "please-use-yarn",
    "yarn": ">=4.0.2"
  },
  "keywords": [],
  "packageManager": "yarn@4.14.1",
  "scripts": {
    "twenty": "twenty",
    "lint": "oxlint -c .oxlintrc.json .",
    "lint:fix": "oxlint --fix -c .oxlintrc.json .",
    "pdf:dev": "yarn workspace ima-pdf-editor dev",
    "pdf:ui": "yarn workspace ima-pdf-editor ui:dev",
    "pdf:build": "yarn workspace ima-pdf-editor build",
    "pdf:deploy": "yarn workspace ima-pdf-editor deploy",
    "pdf:preview": "yarn workspace ima-pdf-editor preview",
    "pdf:secret:auth:username": "yarn workspace ima-pdf-editor secret:auth:username",
    "pdf:secret:auth:password": "yarn workspace ima-pdf-editor secret:auth:password",
    "github:sync-secrets": "node scripts/sync-github-secrets.mjs",
    "act:pdf": "act workflow_dispatch -W .github/workflows/pdf-editor-cd.yml -P ubuntu-latest=-self-hosted --env-file .env --secret-file .env",
    "act:cd": "act push -W .github/workflows/cd.yml -P ubuntu-latest=-self-hosted --env-file .env --secret-file .env",
    "twenty:typecheck": "yarn twenty typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "husky >/dev/null 2>&1 || true"
  },
  "dependencies": {
    "twenty-client-sdk": "2.2.0",
    "twenty-sdk": "2.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/react": "^19.0.0",
    "@typescript/native-preview": "7.0.0-dev.20260505.1",
    "husky": "^9.1.7",
    "oxlint": "^0.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^4.2.1",
    "vitest": "^3.1.1"
  }
}

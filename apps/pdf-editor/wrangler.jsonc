{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ima-pdf-editor",
  "main": "src/worker.ts",
  "compatibility_date": "2026-05-07",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "GOTENBERG_URL": "https://gotenberg.bloomshine.agency"
  }
}
